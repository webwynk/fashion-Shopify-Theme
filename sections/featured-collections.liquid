{%- comment -%}
  Section: Explore Popular Categories (Curated Artisan Furniture & Rugs Slider)
  Features:
  - Header with title, subtitle, and top-right arrow controls (matching Screenshot 2)
  - Soft cream/beige rounded cards with white square inset media boxes
  - Dynamic collection images, titles, and real product count pill badges ("XX+ Items")
  - Automatic fallback to all active store collections if blocks are unselected
{%- endcomment -%}

<section class="ds-pop-cats" id="section-{{ section.id }}">
  <div class="ds-container">

    {%- comment -%} Header Row with Title & Slider Controls {%- endcomment -%}
    <div class="ds-pop-cats__header-row">
      <div class="ds-pop-cats__header-left">
        {%- if section.settings.subtitle != blank -%}
          <p class="ds-pop-cats__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <h2 class="ds-pop-cats__title">
          {{ section.settings.title | default: 'Explore Popular Categories' }}
        </h2>
      </div>

      <div class="ds-pop-cats__nav-controls">
        <button
          class="ds-pop-cats__arrow ds-pop-cats__arrow--prev"
          aria-label="Previous categories"
          data-cat-prev
          type="button"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button
          class="ds-pop-cats__arrow ds-pop-cats__arrow--next"
          aria-label="Next categories"
          data-cat-next
          type="button"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    {%- comment -%} Category Slider Wrapper & Track {%- endcomment -%}
    <div class="ds-pop-cats__wrapper" data-cat-slider>
      <div class="ds-pop-cats__track" data-cat-track>
        {%- liquid
          assign fallback_imgs = "https://images.unsplash.com/photo-1595428774223-ef52624120d2?w=800&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=800&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1533090161767-e6ffed986c88?w=800&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1616046229478-9901c5536a45?w=800&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1594026112284-02bb6f3352fe?w=800&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=800&auto=format&fit=crop&q=80" | split: ','
          assign has_valid_blocks = false
          if section.blocks.size > 0
            for block in section.blocks
              if block.settings.collection != blank or block.settings.label != blank
                assign has_valid_blocks = true
                break
              endif
            endfor
          endif
        -%}

        {%- if has_valid_blocks -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = collections[block.settings.collection]
              if collection == blank and block.settings.label != blank
                assign label_handle = block.settings.label | handleize
                assign collection = collections[label_handle]
              endif

              assign card_title = block.settings.label | default: collection.title | default: 'Category'
              assign card_url   = collection.url | default: '/collections/all'
              assign count_num  = collection.all_products_count | default: 15

              assign card_img = nil
              if block.settings.image != blank
                assign card_img = block.settings.image
              elsif collection.image != blank
                assign card_img = collection.image
              elsif collection.featured_image != blank
                assign card_img = collection.featured_image
              elsif collection.products.first.featured_image != blank
                assign card_img = collection.products.first.featured_image
              endif

              assign img_idx = forloop.index0 | modulo: 6
            -%}

            <a href="{{ card_url }}" class="ds-pop-cat-card" {{ block.shopify_attributes }}>
              <div class="ds-pop-cat-card__media-box">
                {%- if card_img != blank -%}
                  <img
                    src="{{ card_img | image_url: width: 600 }}"
                    alt="{{ card_title | escape }}"
                    class="ds-pop-cat-card__img"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- else -%}
                  <img
                    src="{{ fallback_imgs[img_idx] }}"
                    alt="{{ card_title | escape }}"
                    class="ds-pop-cat-card__img"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>

              <h3 class="ds-pop-cat-card__title">{{ card_title }}</h3>

              <span class="ds-pop-cat-card__badge">
                {{ count_num }}+ Items
              </span>
            </a>
          {%- endfor -%}

        {%- else -%}
          {%- comment -%} Automatic Store Collections Detection {%- endcomment -%}
          {%- assign rendered_count = 0 -%}
          {%- for collection in collections -%}
            {%- if collection.handle != 'frontpage' and collection.handle != 'home-page' and collection.all_products_count > 0 -%}
              {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- liquid
                assign card_img = collection.image | default: collection.featured_image | default: collection.products.first.featured_image
                assign img_idx = forloop.index0 | modulo: 6
              -%}

              <a href="{{ collection.url }}" class="ds-pop-cat-card">
                <div class="ds-pop-cat-card__media-box">
                  {%- if card_img != blank -%}
                    <img
                      src="{{ card_img | image_url: width: 600 }}"
                      alt="{{ collection.title | escape }}"
                      class="ds-pop-cat-card__img"
                      width="600"
                      height="600"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      src="{{ fallback_imgs[img_idx] }}"
                      alt="{{ collection.title | escape }}"
                      class="ds-pop-cat-card__img"
                      width="600"
                      height="600"
                      loading="lazy"
                    >
                  {%- endif -%}
                </div>

                <h3 class="ds-pop-cat-card__title">{{ collection.title }}</h3>

                <span class="ds-pop-cat-card__badge">
                  {{ collection.all_products_count }}+ Items
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}

          {%- if rendered_count == 0 -%}
            {%- assign default_cats = "Storage & Cabinets,Runner Rugs,Artisan Tables,Oushak Rugs,Bookshelves,Desk Accessories" | split: ',' -%}
            {%- assign default_counts = "18+,45+,20+,18+,15+,40+" | split: ',' -%}
            {%- for name in default_cats -%}
              <a href="/collections/all" class="ds-pop-cat-card">
                <div class="ds-pop-cat-card__media-box">
                  <img
                    src="{{ fallback_imgs[forloop.index0] }}"
                    alt="{{ name }}"
                    class="ds-pop-cat-card__img"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                </div>
                <h3 class="ds-pop-cat-card__title">{{ name }}</h3>
                <span class="ds-pop-cat-card__badge">{{ default_counts[forloop.index0] }} Items</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
/* ═════════════════════════════════════════════════════════════
   EXPLORE POPULAR CATEGORIES (WARM LUXURY SLIDER — SCREENSHOT 2)
   ═════════════════════════════════════════════════════════════ */
.ds-pop-cats {
  padding: 4.5rem 0 5rem;
  background: #FFFFFF;
}

.ds-pop-cats__header-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 2.25rem;
  gap: 1.5rem;
}

.ds-pop-cats__subtitle {
  font-family: var(--font-body);
  font-size: 1.0625rem;
  color: #555B68;
  margin: 0 0 0.4rem;
  line-height: 1.4;
}

.ds-pop-cats__title {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  font-weight: 800;
  color: #121316;
  margin: 0;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

/* Arrow Navigation Buttons (Top-Right of Header) */
.ds-pop-cats__nav-controls {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.ds-pop-cats__arrow {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #FFFFFF;
  color: #121316;
  border: 1.5px solid rgba(18, 19, 22, 0.12);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.ds-pop-cats__arrow:hover {
  background: #121316;
  color: #FFFFFF;
  border-color: #121316;
  transform: scale(1.06);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
}

/* Slider Track */
.ds-pop-cats__wrapper {
  position: relative;
  width: 100%;
}

.ds-pop-cats__track {
  display: flex;
  gap: 1.25rem;
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding: 0.5rem 0.25rem 1.5rem;
  scrollbar-width: none;
}

.ds-pop-cats__track::-webkit-scrollbar {
  display: none;
}

/* ── WARM CREAM ROUNDED CATEGORY CARD ── */
.ds-pop-cat-card {
  flex: 0 0 calc((100% - (1.25rem * 5)) / 6);
  min-width: 185px;
  scroll-snap-align: start;
  background: #FDF9F3;
  border: 1.5px solid #F0E8DC;
  border-radius: 20px;
  padding: 1rem 1rem 1.25rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 350ms ease,
              border-color 300ms ease;
}

.ds-pop-cat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 14px 32px rgba(0, 0, 0, 0.07);
  border-color: #E2D2BE;
}

/* Inner White Square Box */
.ds-pop-cat-card__media-box {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #FFFFFF;
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem;
  box-shadow: inset 0 0 0 1px rgba(18, 19, 22, 0.04);
}

.ds-pop-cat-card__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
}

.ds-pop-cat-card:hover .ds-pop-cat-card__img {
  transform: scale(1.08);
}

/* Category Title */
.ds-pop-cat-card__title {
  font-family: var(--font-heading);
  font-size: 1.0625rem;
  font-weight: 800;
  color: #121316;
  margin: 0.85rem 0 0.5rem;
  text-align: center;
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

/* Item Count Pill Badge */
.ds-pop-cat-card__badge {
  display: inline-block;
  background: #F4EDE2;
  color: #7E5B37;
  font-family: var(--font-body);
  font-size: 0.78125rem;
  font-weight: 700;
  padding: 0.25rem 0.85rem;
  border-radius: 9999px;
  letter-spacing: 0.01em;
  line-height: 1.4;
  white-space: nowrap;
}

/* ── RESPONSIVE BREAKPOINTS ── */
/* Laptop / Standard Desktop (4.5 items) */
@media (max-width: 1279px) {
  .ds-pop-cat-card {
    flex: 0 0 calc((100% - (1.25rem * 4)) / 4.5);
    min-width: 175px;
  }
}

/* Tablet (3.2 items) */
@media (max-width: 989px) {
  .ds-pop-cats { padding: 3.5rem 0 4rem; }
  .ds-pop-cat-card {
    flex: 0 0 calc((100% - (1rem * 2)) / 3.2);
    min-width: 165px;
    border-radius: 16px;
    padding: 0.85rem 0.85rem 1rem;
  }
  .ds-pop-cat-card__title { font-size: 0.95rem; }
}

/* Mobile (2.1 items) */
@media (max-width: 639px) {
  .ds-pop-cats { padding: 3rem 0 3.25rem; }
  .ds-pop-cats__header-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .ds-pop-cats__nav-controls {
    align-self: flex-end;
  }
  .ds-pop-cat-card {
    flex: 0 0 calc((100% - 0.75rem) / 2.15);
    min-width: 145px;
    padding: 0.75rem 0.75rem 0.95rem;
  }
  .ds-pop-cat-card__title { font-size: 0.875rem; }
  .ds-pop-cat-card__badge { font-size: 0.7rem; padding: 0.2rem 0.65rem; }
}
</style>

<script>
(function() {
  function initCatSlider() {
    const slider = document.querySelector('[data-cat-slider]');
    if (!slider) return;

    const track = slider.querySelector('[data-cat-track]');
    const prevBtn = slider.querySelector('[data-cat-prev]');
    const nextBtn = slider.querySelector('[data-cat-next]');

    if (!track) return;

    function getScrollAmount() {
      const card = track.querySelector('.ds-pop-cat-card');
      return card ? card.offsetWidth + 20 : 220;
    }

    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatSlider);
  } else {
    initCatSlider();
  }
})();
</script>

{% schema %}
{
  "name": "Popular Categories",
  "tag": "section",
  "class": "section-featured-collections",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Popular Categories"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Discover handcrafted rugs & artisan furniture curated for modern living"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom cover photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore Popular Categories",
      "blocks": [
        { "type": "collection", "settings": { "label": "Storage" } },
        { "type": "collection", "settings": { "label": "Handmade Rugs" } },
        { "type": "collection", "settings": { "label": "Table" } },
        { "type": "collection", "settings": { "label": "Small Rugs" } },
        { "type": "collection", "settings": { "label": "Office Chairs" } },
        { "type": "collection", "settings": { "label": "Executive Desks" } }
      ]
    }
  ]
}
{% endschema %}
