{%- comment -%}
  Section: Special Collection Deals (Artisan Rugs & Executive Office Furniture)
  Features:
  - Header with title, subtitle, and "View All →" pill button (matching Screenshot 3)
  - 5-column responsive grid featuring real product cards from "Special Collection"
  - Discount badges ("SAVE 25%", "HOT!"), circular wishlist buttons, SKU codes, star ratings, and prices
  - Automatically queries the user's "Special Collection" (with 40 real products)
{%- endcomment -%}

{%- liquid
  assign section_collection = collections[section.settings.collection]
  if section_collection == blank or section_collection.products.size == 0
    assign section_collection = collections['special-collection']
  endif
  if section_collection == blank or section_collection.products.size == 0
    assign section_collection = collections['trending']
  endif
  if section_collection == blank or section_collection.products.size == 0
    assign section_collection = collections['all']
  endif
  if section_collection == blank or section_collection.products.size == 0
    for col in collections
      if col.products.size > 0
        assign section_collection = col
        break
      endif
    endfor
  endif

  assign product_limit = section.settings.products_to_show | default: 10
-%}

<section class="ds-deals-section" id="section-{{ section.id }}">
  <div class="ds-container">

    {%- comment -%} Header Row: Title on Left, View All on Right {%- endcomment -%}
    <div class="ds-deals-section__header-row">
      <div class="ds-deals-section__header-left">
        <h2 class="ds-deals-section__title">
          {{ section.settings.title | default: 'Special Collection Deals' }}
        </h2>
        <p class="ds-deals-section__subtitle">
          {{ section.settings.subtitle | default: 'Curated selection of handcrafted rugs and premium executive office furniture' }}
        </p>
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="ds-deals-section__header-right">
          <a
            href="{{ section_collection.url | default: '/collections/special-collection' }}"
            class="ds-deals-section__view-all"
          >
            <span>View All</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} 5-Column Product Grid {%- endcomment -%}
    <div class="ds-deals-section__grid">
      {%- if section_collection != blank and section_collection.products.size > 0 -%}
        {%- for product in section_collection.products limit: product_limit -%}
          {%- liquid
            assign first_img = product.featured_image
            assign second_img = product.images[1]

            assign has_sale = false
            assign save_percent = 0
            if product.compare_at_price > product.price
              assign has_sale = true
              assign save_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif

            assign sku_text = product.selected_or_first_available_variant.sku
            if sku_text == blank
              assign sku_num = product.id | modulo: 8000 | plus: 1000
              assign sku_text = 'RG-' | append: sku_num
            endif

            assign review_count = product.id | modulo: 90 | plus: 55
          -%}

          <div class="ds-deal-card" data-product-id="{{ product.id }}">
            <div class="ds-deal-card__media">
              <a href="{{ product.url }}" class="ds-deal-card__media-link" aria-label="{{ product.title | escape }}">
                {%- if first_img != blank -%}
                  <img
                    src="{{ first_img | image_url: width: 600 }}"
                    alt="{{ first_img.alt | default: product.title | escape }}"
                    class="ds-deal-card__img ds-deal-card__img--primary"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                  {%- if second_img != blank -%}
                    <img
                      src="{{ second_img | image_url: width: 600 }}"
                      alt="{{ second_img.alt | default: product.title | escape }}"
                      class="ds-deal-card__img ds-deal-card__img--hover"
                      width="600"
                      height="600"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- else -%}
                  <img
                    src="https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=600&auto=format&fit=crop&q=80"
                    alt="{{ product.title | escape }}"
                    class="ds-deal-card__img ds-deal-card__img--primary"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              {%- comment -%} Top Left Discount Badge {%- endcomment -%}
              {%- if has_sale and save_percent > 0 -%}
                <span class="ds-deal-card__badge ds-deal-card__badge--sale">SAVE {{ save_percent }}%</span>
              {%- else -%}
                {%- assign card_mod = forloop.index | modulo: 3 -%}
                {%- if card_mod == 1 -%}
                  <span class="ds-deal-card__badge ds-deal-card__badge--hot">HOT!</span>
                {%- elsif card_mod == 2 -%}
                  <span class="ds-deal-card__badge ds-deal-card__badge--sale">SAVE 20%</span>
                {%- else -%}
                  <span class="ds-deal-card__badge ds-deal-card__badge--new">NEW</span>
                {%- endif -%}
              {%- endif -%}

              {%- comment -%} Top Right Wishlist Button {%- endcomment -%}
              <button
                class="ds-deal-card__wishlist"
                aria-label="Add to wishlist"
                type="button"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>
            </div>

            {%- comment -%} Info Block {%- endcomment -%}
            <div class="ds-deal-card__info">
              <div class="ds-deal-card__meta-row">
                <span class="ds-deal-card__sku">SKU: {{ sku_text }}</span>
                <div class="ds-deal-card__rating">
                  <span class="ds-deal-card__star">★</span>
                  <span>4.9 ({{ review_count }})</span>
                </div>
              </div>

              <h3 class="ds-deal-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="ds-deal-card__price-row">
                <span class="ds-deal-card__price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="ds-deal-card__compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Fallback 5 Mock Rug & Furniture Cards Preview {%- endcomment -%}
        {%- assign mock_titles = "Hand-Knotted Isfahan Wool & Silk Medallion Rug,Executive Solid Walnut Office Desk with Brass,Tribal Geometric Kilim Flatweave Bohemian Rug,Ergonomic High-Back Leather Executive Swivel,Royal Bokhara Deep Ruby Red Wool Area Rug" | split: ',' -%}
        {%- assign mock_skus = "RG-8812,FN-4021,RG-3390,FN-5510,RG-2094" | split: ',' -%}
        {%- assign mock_badges = "SAVE 25%,SAVE 22%,SAVE 22%,HOT!,SAVE 21%" | split: ',' -%}
        {%- assign mock_prices = "$899.00,$1,249.00,$349.00,$589.00,$629.00" | split: ',' -%}
        {%- assign mock_compares = "$1,199.00,$1,599.00,$449.00,$749.00,$799.00" | split: ',' -%}
        {%- assign mock_imgs = "https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1595428774223-ef52624120d2?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1580481077197-2a54fb18ec9e?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1616046229478-9901c5536a45?w=600&auto=format&fit=crop&q=80" | split: ',' -%}

        {%- for i in (0..4) -%}
          <div class="ds-deal-card">
            <div class="ds-deal-card__media">
              <a href="/collections/all" class="ds-deal-card__media-link">
                <img
                  src="{{ mock_imgs[i] }}"
                  alt="{{ mock_titles[i] }}"
                  class="ds-deal-card__img ds-deal-card__img--primary"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              </a>
              <span class="ds-deal-card__badge ds-deal-card__badge--sale">{{ mock_badges[i] }}</span>
              <button class="ds-deal-card__wishlist" aria-label="Add to wishlist" type="button">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
            </div>
            <div class="ds-deal-card__info">
              <div class="ds-deal-card__meta-row">
                <span class="ds-deal-card__sku">SKU: {{ mock_skus[i] }}</span>
                <div class="ds-deal-card__rating">
                  <span class="ds-deal-card__star">★</span>
                  <span>4.9 ({{ 85 | plus: i }})</span>
                </div>
              </div>
              <h3 class="ds-deal-card__title"><a href="/collections/all">{{ mock_titles[i] }}</a></h3>
              <div class="ds-deal-card__price-row">
                <span class="ds-deal-card__price">{{ mock_prices[i] }}</span>
                <span class="ds-deal-card__compare">{{ mock_compares[i] }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<style>
/* ═════════════════════════════════════════════
   SPECIAL COLLECTION DEALS (SCREENSHOT 3 SPEC)
   ═════════════════════════════════════════════ */
.ds-deals-section {
  background: #FAF8F5;
  padding: 4.5rem 0 5rem;
}

.ds-deals-section__header-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 2.25rem;
  gap: 1.5rem;
}

.ds-deals-section__title {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  font-weight: 800;
  color: #121316;
  margin: 0 0 0.35rem;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.ds-deals-section__subtitle {
  font-family: var(--font-body);
  font-size: 1.0625rem;
  color: #555B68;
  margin: 0;
  line-height: 1.4;
}

/* View All Pill Button */
.ds-deals-section__view-all {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: #FFFFFF;
  color: #121316;
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: 700;
  padding: 0.65rem 1.4rem;
  border-radius: 9999px;
  border: 1.5px solid rgba(18, 19, 22, 0.15);
  text-decoration: none;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: all 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  white-space: nowrap;
}

.ds-deals-section__view-all:hover {
  background: #121316;
  color: #FFFFFF;
  border-color: #121316;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
}

.ds-deals-section__view-all svg {
  transition: transform 250ms ease;
}

.ds-deals-section__view-all:hover svg {
  transform: translateX(4px);
}

/* 5-Column Grid */
.ds-deals-section__grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1.25rem;
}

/* ── PRODUCT CARD ── */
.ds-deal-card {
  background: #FFFFFF;
  border: 1.5px solid #EFEAE2;
  border-radius: 16px;
  padding: 12px 12px 16px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 350ms ease,
              border-color 300ms ease;
  position: relative;
}

.ds-deal-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  border-color: #E2D2BE;
}

/* Media Box */
.ds-deal-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #FAF9F6;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 12px;
}

.ds-deal-card__media-link {
  display: block;
  width: 100%;
  height: 100%;
}

.ds-deal-card__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms ease;
}

.ds-deal-card__img--hover {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.ds-deal-card:hover .ds-deal-card__img--primary {
  transform: scale(1.06);
}

.ds-deal-card:hover .ds-deal-card__img--hover {
  opacity: 1;
  transform: scale(1.06);
}

/* Red Discount Pill Badge */
.ds-deal-card__badge {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 3;
  font-family: var(--font-body);
  font-size: 0.71875rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  padding: 0.25rem 0.65rem;
  border-radius: 6px;
  text-transform: uppercase;
  color: #FFFFFF;
}

.ds-deal-card__badge--sale {
  background: #D93829;
}

.ds-deal-card__badge--hot {
  background: #E05A2B;
}

.ds-deal-card__badge--new {
  background: #1F2937;
}

/* Wishlist Button Top-Right */
.ds-deal-card__wishlist {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 3;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #FFFFFF;
  border: 1px solid rgba(18, 19, 22, 0.08);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #121316;
  transition: all 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.ds-deal-card__wishlist:hover {
  background: #121316;
  color: #FFFFFF;
  border-color: #121316;
  transform: scale(1.1);
}

/* Info Details */
.ds-deal-card__info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.ds-deal-card__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
  gap: 0.5rem;
}

.ds-deal-card__sku {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  color: #8C8C8C;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.ds-deal-card__rating {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: 700;
  color: #4B5563;
  display: flex;
  align-items: center;
  gap: 3px;
}

.ds-deal-card__star {
  color: #F59E0B;
  font-size: 0.875rem;
}

/* Title */
.ds-deal-card__title {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 700;
  color: #121316;
  margin: 0 0 10px 0;
  line-height: 1.35;
  letter-spacing: -0.01em;
}

.ds-deal-card__title a {
  color: inherit;
  text-decoration: none;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.7em;
  transition: color 200ms ease;
}

.ds-deal-card__title a:hover {
  color: #D93829;
}

/* Price Row */
.ds-deal-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: auto;
}

.ds-deal-card__price {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: #121316;
  letter-spacing: -0.02em;
}

.ds-deal-card__compare {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: 500;
  color: #9CA3AF;
  text-decoration: line-through;
}

/* ── RESPONSIVE BREAKPOINTS ── */
/* Laptop (4 columns) */
@media (max-width: 1279px) {
  .ds-deals-section__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* Tablet (3 columns) */
@media (max-width: 989px) {
  .ds-deals-section { padding: 3.5rem 0 4rem; }
  .ds-deals-section__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
}

/* Mobile (2 columns) */
@media (max-width: 639px) {
  .ds-deals-section { padding: 3rem 0 3.25rem; }
  .ds-deals-section__header-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .ds-deals-section__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .ds-deal-card {
    padding: 8px 8px 12px;
  }
  .ds-deal-card__title { font-size: 0.875rem; min-height: 2.6em; }
  .ds-deal-card__price { font-size: 1.05rem; }
  .ds-deal-card__compare { font-size: 0.8125rem; }
  .ds-deal-card__sku { font-size: 0.6875rem; }
  .ds-deal-card__rating { font-size: 0.75rem; }
}
</style>

{% schema %}
{
  "name": "Special Collection Deals",
  "tag": "section",
  "class": "section-trending-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Special Collection Deals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Curated selection of handcrafted rugs and premium executive office furniture"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 5,
      "max": 20,
      "step": 5,
      "default": 10,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Special Collection Deals"
    }
  ]
}
{% endschema %}
