{%- comment -%}
  Section: WoodMart Dual-Row Header (Foesta Edition with Custom Brand Colors & Large Typography)
{%- endcomment -%}

{%- render 'header-drawer' -%}

<header class="wm-header" id="section-{{ section.id }}">

  {%- comment -%} ════ DESKTOP HEADER (MIN-WIDTH: 990PX) ════ {%- endcomment -%}
  <div class="wm-header__desktop small-hide medium-hide">

    {%- comment -%} TOP MAIN ROW {%- endcomment -%}
    <div class="wm-header__top-row ds-container">
      {%- comment -%} Brand Logo {%- endcomment -%}
      <div class="wm-header__logo">
        <a href="{{ routes.root_url }}" class="wm-header__logo-link">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 400 | image_tag: class: 'wm-header__logo-img', alt: shop.name }}
          {%- else -%}
            <span class="wm-header__logo-text">{{ section.settings.logo_text | default: shop.name }}<span>.</span></span>
          {%- endif -%}
        </a>
      </div>

      {%- comment -%} Centered Search Bar {%- endcomment -%}
      <div class="wm-header__search-container">
        <form action="{{ routes.search_url }}" method="get" role="search" class="wm-header__search-form">
          <input
            type="search"
            name="q"
            class="wm-header__search-input"
            placeholder="{{ section.settings.search_placeholder | default: 'Search for products...' }}"
            aria-label="Search for products"
            autocomplete="off"
          >
          <button type="submit" class="wm-header__search-btn" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </form>
      </div>

      {%- comment -%} Support Badges {%- endcomment -%}
      <div class="wm-header__support-badges">
        <div class="wm-support-badge">
          <div class="wm-support-badge__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="wm-support-badge__info">
            <span class="wm-support-badge__title">24/7 Support</span>
            <span class="wm-support-badge__value">{{ section.settings.support_phone | default: '+1 (800) 123-4567' }}</span>
          </div>
        </div>

        <div class="wm-support-badge">
          <div class="wm-support-badge__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div class="wm-support-badge__info">
            <span class="wm-support-badge__title">Worldwide</span>
            <span class="wm-support-badge__value wm-support-badge__value--accent">{{ section.settings.shipping_text | default: 'Free Shipping' }}</span>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} BOTTOM NAVIGATION ROW {%- endcomment -%}
    <div class="wm-header__bottom-bar">
      <div class="ds-container wm-header__nav-container">

        {%- comment -%} Left Side: Hot Deals Badge {%- endcomment -%}
        <div class="wm-nav-left">
          <a href="/collections/all" class="wm-deals-badge">
            <span class="wm-deals-badge__fire">🔥</span>
            <span class="wm-deals-badge__text">Hot Deals</span>
            <span class="wm-deals-badge__pulse"></span>
          </a>
        </div>

        {%- comment -%} Main Navigation Menu Capsule Bar {%- endcomment -%}
        <nav class="wm-header__main-nav">
          <ul class="wm-main-menu">
            {%- assign cat_menu = linklists[section.settings.categories_menu] -%}
            {%- if cat_menu == blank or cat_menu.links.size == 0 -%}
              {%- assign cat_menu = linklists['categories-menu'] -%}
            {%- endif -%}

            {%- if section.settings.menu.links.size > 0 -%}
              {%- for link in section.settings.menu.links -%}
                {%- assign link_title_lower = link.title | downcase -%}
                {%- assign is_megamenu = false -%}
                {%- if link_title_lower contains 'cat' or link_title_lower contains 'collection' or link.links.size > 0 -%}
                  {%- assign is_megamenu = true -%}
                {%- endif -%}

                <li class="wm-main-menu__item{% if is_megamenu %} has-megamenu{% endif %}">
                  <a href="{{ link.url }}" class="wm-main-menu__link{% if link.current %} is-active{% endif %}">
                    <span>{{ link.title | escape }}</span>
                    {%- if link.current -%}
                      <span class="wm-active-dot"></span>
                    {%- endif -%}
                    {%- if is_megamenu -%}
                      <svg class="wm-menu-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                    {%- endif -%}
                  </a>

                  {%- if is_megamenu -%}
                    {%- comment -%} DUAL-PANE GLASSMORPHISM MEGA MENU DROPDOWN {%- endcomment -%}
                    <div class="wm-megamenu-panel">
                      <div class="wm-megamenu-inner">
                        {%- comment -%} LEFT/GRID COLUMN: Primary Categories {%- endcomment -%}
                        <div class="wm-megamenu-col wm-megamenu-col--categories">
                          <div class="wm-megamenu-col-header">
                            <span class="wm-megamenu-eyebrow">✦ ALL CATEGORIES ✦</span>
                            <h4 class="wm-megamenu-col-title">Explore Collections</h4>
                          </div>

                          <div class="wm-megamenu-grid">
                            {%- if cat_menu != blank and cat_menu.links.size > 0 -%}
                              {%- for cat_link in cat_menu.links -%}
                                <a href="{{ cat_link.url }}" class="wm-megamenu-card">
                                  <span class="wm-megamenu-card__icon">
                                    {%- render 'category-icon', title: cat_link.title -%}
                                  </span>
                                  <span class="wm-megamenu-card__title">{{ cat_link.title | escape }}</span>
                                </a>
                              {%- endfor -%}
                            {%- else -%}
                              {%- assign default_cats = 'Pet Supplies & Accessories,Health & Grooming,Skincare & Beauty,Auto Parts & Accessories,Home Organisation & Décor,Toys & Games,Office Equipment & Supplies,Cleaning Supplies,Sports & Outdoor Supplies' | split: ',' -%}
                              {%- for cat in default_cats -%}
                                {%- assign cat_handle = cat | handleize -%}
                                {%- assign matched_col = collections[cat_handle] -%}
                                {%- assign col_url = matched_col.url | default: '/collections/all' -%}
                                <a href="{{ col_url }}" class="wm-megamenu-card">
                                  <span class="wm-megamenu-card__icon">
                                    {%- render 'category-icon', title: cat -%}
                                  </span>
                                  <span class="wm-megamenu-card__title">{{ cat }}</span>
                                </a>
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        </div>

                        {%- comment -%} MIDDLE COLUMN: Subcategories Featured Panel {%- endcomment -%}
                        <div class="wm-megamenu-col wm-megamenu-col--subcategories">
                          <div class="wm-megamenu-col-header">
                            <span class="wm-megamenu-eyebrow">✦ FEATURED SUBCATEGORIES ✦</span>
                            <h4 class="wm-megamenu-col-title">Sports & Outdoor Supplies</h4>
                          </div>

                          <div class="wm-megamenu-sublist">
                            {%- assign sports_subs = 'Hiking & Outdoor,Jogging & Exercise Supplies,Sports Equipment & Supplies' | split: ',' -%}
                            {%- for sub in sports_subs -%}
                              {%- assign sub_handle = sub | handleize -%}
                              {%- assign matched_sub = collections[sub_handle] -%}
                              {%- assign sub_url = matched_sub.url | default: '/collections/sports-outdoor-supplies' -%}
                              <a href="{{ sub_url }}" class="wm-megamenu-sublink">
                                <span class="wm-megamenu-card__icon wm-megamenu-card__icon--sub">
                                  {%- render 'category-icon', title: sub -%}
                                </span>
                                <span class="wm-megamenu-sublink__text">{{ sub }}</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                              </a>
                            {%- endfor -%}
                          </div>
                        </div>

                        {%- comment -%} RIGHT COLUMN: Luxury Visual Feature Tile {%- endcomment -%}
                        <div class="wm-megamenu-col wm-megamenu-col--promo">
                          <div class="wm-megamenu-promo-card">
                            <span class="wm-promo-badge">✦ EXCLUSIVE ✦</span>
                            <h4 class="wm-promo-title">New Season Drops</h4>
                            <p class="wm-promo-desc">Discover curated luxury fashion, lifestyle accessories & home decor.</p>
                            <a href="/collections/all" class="wm-promo-btn">Explore Shop →</a>
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} DEFAULT NAV CAPSULE ITEMS {%- endcomment -%}
              {%- assign default_nav = 'Home|Categories|New Arrivals|Best Sellers|About Us|Contact' | split: '|' -%}
              {%- for item in default_nav -%}
                {%- assign is_megamenu = false -%}
                {%- if item == 'Categories' -%}
                  {%- assign is_megamenu = true -%}
                {%- endif -%}

                <li class="wm-main-menu__item{% if is_megamenu %} has-megamenu{% endif %}">
                  <a href="{% if item == 'Home' %}/{% else %}/collections/all{% endif %}" class="wm-main-menu__link{% if item == 'Home' %} is-active{% endif %}">
                    <span>{{ item }}</span>
                    {%- if item == 'Home' -%}
                      <span class="wm-active-dot"></span>
                    {%- endif -%}
                    {%- if is_megamenu -%}
                      <svg class="wm-menu-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                    {%- endif -%}
                  </a>

                  {%- if is_megamenu -%}
                    {%- comment -%} DUAL-PANE GLASSMORPHISM MEGA MENU DROPDOWN {%- endcomment -%}
                    <div class="wm-megamenu-panel">
                      <div class="wm-megamenu-inner">
                        {%- comment -%} LEFT/GRID COLUMN: Primary Categories {%- endcomment -%}
                        <div class="wm-megamenu-col wm-megamenu-col--categories">
                          <div class="wm-megamenu-col-header">
                            <span class="wm-megamenu-eyebrow">✦ ALL CATEGORIES ✦</span>
                            <h4 class="wm-megamenu-col-title">Explore Collections</h4>
                          </div>

                          <div class="wm-megamenu-grid">
                            {%- assign default_cats = 'Pet Supplies & Accessories,Health & Grooming,Skincare & Beauty,Auto Parts & Accessories,Home Organisation & Décor,Toys & Games,Office Equipment & Supplies,Cleaning Supplies,Sports & Outdoor Supplies' | split: ',' -%}
                            {%- for cat in default_cats -%}
                              {%- assign cat_handle = cat | handleize -%}
                              {%- assign matched_col = collections[cat_handle] -%}
                              {%- assign col_url = matched_col.url | default: '/collections/all' -%}
                              <a href="{{ col_url }}" class="wm-megamenu-card">
                                <span class="wm-megamenu-card__icon">
                                  {%- render 'category-icon', title: cat -%}
                                </span>
                                <span class="wm-megamenu-card__title">{{ cat }}</span>
                              </a>
                            {%- endfor -%}
                          </div>
                        </div>

                        {%- comment -%} MIDDLE COLUMN: Subcategories Featured Panel {%- endcomment -%}
                        <div class="wm-megamenu-col wm-megamenu-col--subcategories">
                          <div class="wm-megamenu-col-header">
                            <span class="wm-megamenu-eyebrow">✦ FEATURED SUBCATEGORIES ✦</span>
                            <h4 class="wm-megamenu-col-title">Sports & Outdoor Supplies</h4>
                          </div>

                          <div class="wm-megamenu-sublist">
                            {%- assign sports_subs = 'Hiking & Outdoor,Jogging & Exercise Supplies,Sports Equipment & Supplies' | split: ',' -%}
                            {%- for sub in sports_subs -%}
                              {%- assign sub_handle = sub | handleize -%}
                              {%- assign matched_sub = collections[sub_handle] -%}
                              {%- assign sub_url = matched_sub.url | default: '/collections/sports-outdoor-supplies' -%}
                              <a href="{{ sub_url }}" class="wm-megamenu-sublink">
                                <span class="wm-megamenu-card__icon wm-megamenu-card__icon--sub">
                                  {%- render 'category-icon', title: sub -%}
                                </span>
                                <span class="wm-megamenu-sublink__text">{{ sub }}</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                              </a>
                            {%- endfor -%}
                          </div>
                        </div>

                        {%- comment -%} RIGHT COLUMN: Luxury Visual Feature Tile {%- endcomment -%}
                        <div class="wm-megamenu-col wm-megamenu-col--promo">
                          <div class="wm-megamenu-promo-card">
                            <span class="wm-promo-badge">✦ EXCLUSIVE ✦</span>
                            <h4 class="wm-promo-title">New Season Drops</h4>
                            <p class="wm-promo-desc">Discover curated luxury fashion, lifestyle accessories & home decor.</p>
                            <a href="/collections/all" class="wm-promo-btn">Explore Shop →</a>
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>

        {%- comment -%} Right Actions Area {%- endcomment -%}
        <div class="wm-header__actions">
          <div class="wm-header__selectors">
            <span class="wm-selector">USA ▾</span>
            <span class="wm-selector">USD ▾</span>
          </div>

          {%- if shop.customer_accounts_enabled -%}
            <a href="{{ routes.account_url }}" class="wm-action-btn" aria-label="Account">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </a>
          {%- else -%}
            <a href="/account/login" class="wm-action-btn" aria-label="Account">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </a>
          {%- endif -%}

          <a href="#" class="wm-action-btn wm-action-btn--badge" aria-label="Compare">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
            <span class="wm-action-badge">0</span>
          </a>

          <a href="/pages/wishlist" class="wm-action-btn wm-action-btn--badge" aria-label="Wishlist">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span class="wm-action-badge">0</span>
          </a>

          {%- comment -%} Cart Pill Button with Live Total {%- endcomment -%}
          <a href="{{ routes.cart_url }}" class="wm-cart-btn">
            <span class="wm-cart-btn__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span class="wm-cart-btn__badge">{{ cart.item_count }}</span>
            </span>
            <span class="wm-cart-btn__price">{{ cart.total_price | money }}</span>
          </a>
        </div>

      </div>
    </div>

  </div>

  {%- comment -%} ════ MOBILE HEADER (MAX-WIDTH: 989PX) ════ {%- endcomment -%}
  <div class="wm-header__mobile">
    {%- comment -%} Mobile Row 1: Left (Toggle + Logo) | Right (Account, Wishlist, Cart) {%- endcomment -%}
    <div class="wm-mobile-top">
      <div class="wm-mobile-left">
        <button type="button" class="wm-mobile-toggle" onclick="openWmMobileDrawer()" aria-label="Open navigation menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        <div class="wm-mobile-logo">
          <a href="{{ routes.root_url }}" class="wm-mobile-logo-link">
            {%- if settings.logo != blank -%}
              {{ settings.logo | image_url: width: 300 | image_tag: class: 'wm-mobile-logo-img', alt: shop.name }}
            {%- else -%}
              <span class="wm-header__logo-text">{{ section.settings.logo_text | default: shop.name }}<span>.</span></span>
            {%- endif -%}
          </a>
        </div>
      </div>

      <div class="wm-mobile-actions">
        <a href="{{ routes.account_url }}" class="wm-mobile-action-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>

        <a href="/pages/wishlist" class="wm-mobile-action-btn wm-mobile-action-btn--badge" aria-label="Wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="wm-action-badge">0</span>
        </a>

        <a href="{{ routes.cart_url }}" class="wm-mobile-cart-btn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="wm-cart-btn__badge">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>

    {%- comment -%} Mobile Row 2: Full Width Search Pill {%- endcomment -%}
    <div class="wm-mobile-search-row">
      <form action="{{ routes.search_url }}" method="get" role="search" class="wm-header__search-form">
        <input
          type="search"
          name="q"
          class="wm-header__search-input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search for products...' }}"
          aria-label="Search for products"
          autocomplete="off"
        >
        <button type="submit" class="wm-header__search-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    </div>
  </div>

</header>

<style>
/* ════════════════════════════════════════════════════════════
   FOESTA BRAND DUAL-ROW HEADER SYSTEM (LARGE TYPOGRAPHY)
   ════════════════════════════════════════════════════════════ */
.wm-header {
  position: relative;
  background: #FFFFFF;
  border-bottom: 1px solid #E5E8F0;
  font-family: var(--font-body);
}

/* TOP ROW */
.wm-header__top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18px;
  padding-bottom: 18px;
  gap: 2.5rem;
}

.wm-header__logo-text {
  font-family: var(--font-heading);
  font-size: 2.25rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #121316;
}

.wm-header__logo-text span {
  color: var(--color-accent-gold, #C9A96E);
}

.wm-header__logo-img {
  max-height: 48px;
  width: auto;
}

/* SEARCH CONTAINER */
.wm-header__search-container {
  flex: 1;
  max-width: 680px;
}

.wm-header__search-form {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.wm-header__search-input {
  width: 100%;
  height: 52px;
  padding: 0 60px 0 24px;
  border-radius: var(--radius-pill);
  border: 1.5px solid #E5E8F0;
  background: #FFFFFF;
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 500;
  color: #121316;
  outline: none;
  transition: all 250ms ease;
  box-shadow: 0 4px 14px rgba(18, 19, 22, 0.03);
}

.wm-header__search-input:focus {
  border-color: #121316;
  box-shadow: 0 0 0 4px rgba(18, 19, 22, 0.08);
}

.wm-header__search-input::placeholder {
  color: #8E95A2;
}

.wm-header__search-btn {
  position: absolute;
  right: 6px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: #121316;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), background 200ms ease;
}

.wm-header__search-btn:hover {
  background: var(--color-accent-gold, #C9A96E);
  transform: scale(1.06);
}

/* SUPPORT BADGES */
.wm-header__support-badges {
  display: flex;
  align-items: center;
  gap: 2.25rem;
}

.wm-support-badge {
