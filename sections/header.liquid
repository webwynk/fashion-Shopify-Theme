/* MEGA MENU PANEL ATTACHED TO CAPSULE BAR - STRICT VISIBILITY */
.wm-megamenu-panel {
  display: none;
  position: absolute;
  top: calc(100% + 14px);
  left: 50%;
  transform: translateX(-50%) translateY(12px) scale(0.98);
  width: 960px;
  max-width: calc(100vw - 40px);
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(18, 19, 22, 0.08);
  border-radius: 26px;
  box-shadow: 0 28px 70px rgba(18, 19, 22, 0.16);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1), transform 280ms cubic-bezier(0.16, 1, 0.3, 1), visibility 280ms cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 900;
  padding: 24px;
}

/* Invisible hover bridge */
.wm-megamenu-panel::before {
  content: '';
  position: absolute;
  top: -18px;
  left: 0;
  width: 100%;
  height: 20px;
  background: transparent;
}

.wm-main-menu__item.has-megamenu:hover .wm-megamenu-panel {
  display: block;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0) scale(1);
}

