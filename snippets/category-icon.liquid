{% comment %}
  Snippet: Category Icon Switcher
  Accepts: 'title' or 'handle' (string)
  Renders matching custom SVG icon for each product category
{% endcomment %}

{%- assign cat_key = title | default: handle | downcase | slugify -%}

{%- if cat_key contains 'pet' -%}
  {%- comment -%} Pet Supplies & Accessories (Paw Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 14c-2.8 0-5 2.2-5 5 0 .6.4 1 1 1h8c.6 0 1-.4 1-1 0-2.8-2.2-5-5-5z"/>
    <path d="M6.5 10c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
    <path d="M17.5 10c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
    <path d="M9.5 5.5c.8 0 1.5-.7 1.5-1.5S10.3 2.5 9.5 2.5 8 3.2 8 4s.7 1.5 1.5 1.5z"/>
    <path d="M14.5 5.5c.8 0 1.5-.7 1.5-1.5S15.3 2.5 14.5 2.5 13 3.2 13 4s.7 1.5 1.5 1.5z"/>
  </svg>

{%- elsif cat_key contains 'health' or cat_key contains 'grooming' -%}
  {%- comment -%} Health & Grooming (Heart Pulse / Shield Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
    <path d="M12 9v6"/>
    <path d="M9 12h6"/>
  </svg>

{%- elsif cat_key contains 'skin' or cat_key contains 'beauty' -%}
  {%- comment -%} Skincare & Beauty (Sparkles / Cosmetics Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
    <path d="M5 3v4"/>
    <path d="M19 17v4"/>
  </svg>

{%- elsif cat_key contains 'auto' or cat_key contains 'car' -%}
  {%- comment -%} Auto Parts & Accessories (Car Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.2 1 11.9 1 12.6V16c0 .6.4 1 1 1h2"/>
    <circle cx="7" cy="17" r="2"/>
    <circle cx="17" cy="17" r="2"/>
    <path d="M9 17h6"/>
  </svg>

{%- elsif cat_key contains 'home' or cat_key contains 'organisation' or cat_key contains 'decor' -%}
  {%- comment -%} Home Organisation & Décor (Home Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <polyline points="9 22 9 12 15 12 15 22"/>
  </svg>

{%- elsif cat_key contains 'toy' or cat_key contains 'game' -%}
  {%- comment -%} Toys & Games (Gamepad Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="6" y1="12" x2="10" y2="12"/>
    <line x1="8" y1="10" x2="8" y2="14"/>
    <circle cx="15" cy="13" r="1"/>
    <circle cx="18" cy="11" r="1"/>
    <rect x="2" y="6" width="20" height="12" rx="6"/>
  </svg>

{%- elsif cat_key contains 'office' -%}
  {%- comment -%} Office Equipment & Supplies (Briefcase Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
  </svg>

{%- elsif cat_key contains 'clean' -%}
  {%- comment -%} Cleaning Supplies (Sparkles / Spray Bottle Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 2v6"/>
    <path d="m4.93 10.93 4.24 4.24"/>
    <path d="m14.83 9.17 4.24 4.24"/>
    <path d="M14 8a2 2 0 0 0-4 0v10a2 2 0 0 0 4 0Z"/>
    <path d="M9 18a3 3 0 0 0 6 0"/>
  </svg>

{%- elsif cat_key contains 'sport' or cat_key contains 'outdoor' or cat_key contains 'hike' or cat_key contains 'jog' or cat_key contains 'exercise' -%}
  {%- comment -%} Sports & Outdoor Supplies (Dumbbell / Activity Icon) {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m6.5 6.5 11 11"/>
    <path d="m21 21-1-1"/>
    <path d="m3 3 1 1"/>
    <path d="m18 22 4-4"/>
    <path d="m2 6 4-4"/>
    <path d="m3 10 7-7"/>
    <path d="m14 21 7-7"/>
  </svg>

{%- else -%}
  {%- comment -%} Default Grid/Box Icon {%- endcomment -%}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="7" height="7" rx="1"/>
    <rect x="14" y="3" width="7" height="7" rx="1"/>
    <rect x="14" y="14" width="7" height="7" rx="1"/>
    <rect x="3" y="14" width="7" height="7" rx="1"/>
  </svg>
{%- endif -%}
